# seoji 증분 수집 예시 (crontab -e 에 붙여 넣고 경로를 맞추세요)
# SEOJI_CERT_KEY / DATABASE_URL 은 저장소 루트의 .env 에서 읽습니다.
SEOJI=/path/to/seoji
PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin

# 매일 03:00 — 발행예정일 [오늘-30일, 오늘+90일]
0 3 * * *   cd $SEOJI && uv run seoji harvest --window daily  && uv run seoji silver refresh >> logs/daily.log 2>&1
# 매주 일요일 04:00 — [오늘-365일, 오늘-31일] (늦게 등록·수정된 레코드 보정)
0 4 * * 0   cd $SEOJI && uv run seoji harvest --window weekly && uv run seoji silver refresh >> logs/weekly.log 2>&1
# 매일 02:30 — 새로 등록된 레코드(INPUT_DATE 정렬의 끝부분)
30 2 * * *  cd $SEOJI && { uv run seoji harvest --all && uv run seoji silver refresh; } >> logs/tail.log 2>&1
# 분기 첫날 05:00 — 전체를 처음부터 다시 훑어 기존 레코드의 수정분 반영 (약 2.5시간)
0 5 1 1,4,7,10 * cd $SEOJI && { uv run seoji harvest --all --restart && uv run seoji silver refresh; } >> logs/quarterly.log 2>&1
